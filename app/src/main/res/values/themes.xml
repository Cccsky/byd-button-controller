<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BYDButtonController" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/byd_red_500</item>
        <item name="colorPrimaryVariant">@color/byd_red_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/byd_steel</item>
        <item name="colorSecondaryVariant">@color/byd_navy</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- 页面自带 MaterialToolbar，禁用系统 ActionBar 避免双标题栏 -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="SettingsSectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>
</resources>
